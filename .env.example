# --- Obligatoire (>= 32 caractères) : deploy.sh le génère ; sinon : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# --- Port local (127.0.0.1) : vide = 8000 s'il est libre, sinon premier port libre dès 8100 (choisi par deploy.sh)
APP_PORT=

# --- Stockage
DATA_DIR=/opt/lecteur/data
MAX_UPLOAD_MB=1024

# --- OCR (installer tesseract-ocr-ara pour l'arabe puis ajouter +ara)
OCR_LANG=fra+eng+ara
OCR_DPI=300

# --- Voix : browser (voix de l'appareil) ou piper (voix neuronale locale, audio en arrière-plan)
TTS_PROVIDER=piper
PIPER_CMD=/opt/lecteur/venv/bin/piper
PIPER_VOICE_FR=/opt/lecteur/voices/fr_FR-siwis-medium.onnx
PIPER_VOICE_EN=/opt/lecteur/voices/en_US-lessac-medium.onnx
PIPER_VOICE_FR_HOMME=/opt/lecteur/voices/fr_FR-tom-medium.onnx
PIPER_VOICE_EN_HOMME=/opt/lecteur/voices/en_US-ryan-medium.onnx
PIPER_VOICE_AR=/opt/lecteur/voices/ar_JO-kareem-medium.onnx
# (voix femme = PIPER_VOICE_FR / _EN ; l'arabe n'existe qu'en voix d'homme chez Piper)

# --- LLM : valeurs PAR DÉFAUT. Tout est ensuite modifiable dans l'app (onglet ⚙️ Réglages) :
#     clé OpenRouter, URL OmniRoute, choix de la passerelle et du modèle pour la traduction / la discussion / les embeddings.
# URL d'Ollama (local)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# URL d'OmniRoute, ex. https://omniroute.exemple.com/v1 (facultatif)
OMNIROUTE_BASE_URL=
TRANSLATE_MODEL=qwen2.5:7b
CHAT_MODEL=llama3.2:3b
EMBED_MODEL=bge-m3

# --- Segments chinois/japonais/coréen : plus courts (1 caractère ≈ 1 mot)
SEGMENT_MAX_CHARS_CJK=160

# --- Traduction groupée : passages par demande (1 = un par un, mesuré le plus stable sur CPU ; 3 avec un modèle rapide)
TRANSLATE_BATCH=1
